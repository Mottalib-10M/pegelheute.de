---
/** Page à intégrer (iframe) : l'outil pegel seul, en deux langues ; `?station=koeln` présélectionne une station. noindex, hors sitemap. */
import '../../../styles/global.css';
import PegelTool from '../../../components/pegel/PegelTool';
import { SITE_URL, SITE_NAMES, LANG_TAGS } from '../../../data/site-config';
import { route } from '../../../i18n/routes';
import { RIVERS, FEATURED, allCompact, raw, FETCHED_AT } from '../../../lib/pegel';
import { SOURCES } from '../../../lib/helpers';
import type { Lang } from '../../../lib/format';
export function getStaticPaths() {
  return (['de', 'en'] as const).map((lang) => ({ params: { lang, name: 'pegel' } }));
}
const { lang } = Astro.params as { lang: Lang };
const page = `${SITE_URL}${route('home', lang)}`;
const rivers = Object.fromEntries(RIVERS.map((r) => [r.api, r[lang]]));
const slugs = Object.fromEntries(FEATURED.map((f) => [f.id, raw(f.api).uuid]));
const note = { de: 'Daten: PEGELONLINE (WSV), DL-DE->Zero-2.0 · unabhängiges Werkzeug von Radif Partners, kein Angebot einer Behörde, keine Hochwasserwarnung', en: 'Data: PEGELONLINE (WSV), DL-DE->Zero-2.0 · independent tool by Radif Partners, not a government service, no flood warning' }[lang];
const ttl = { de: 'Pegel aktuell (zum Einbinden)', en: 'River level today (embed)' }[lang];
---
<!doctype html>
<html lang={LANG_TAGS[lang]}>
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{ttl}</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={page} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <main><PegelTool client:load lang={lang} stations={allCompact()} initial={raw('KÖLN').uuid} idPrefix="embed" rivers={rivers} fetchedAt={FETCHED_AT} methodHref={`${SITE_URL}${route('method', lang)}`} warnHref={SOURCES(lang).hochwasserzentralen.url} slugs={slugs} /></main>
    <p class="mt-2 text-center text-xs text-navy-600"><a href={page} target="_blank" rel="noopener" class="underline">{SITE_NAMES[lang]}</a> · {note}</p>
  </body>
</html>
