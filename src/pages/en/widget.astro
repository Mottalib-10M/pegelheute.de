---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/${lang}/pegel/?station=koeln" title="River level today, Pegel Heute" width="100%" height="620" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed a German river gauge for free: Pegel Heute widget" description="Show a Rhine, Elbe or Danube gauge for free on your club, marina or campsite website: copy the code once and the reading refreshes itself from PEGELONLINE." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed Pegel Heute</h1>
    <p class="mt-3 text-lg text-navy-700">For clubs, marinas, campsites and local media: copy once, and the gauge shows the latest PEGELONLINE reading on every visit.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <h2>Code to copy</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Visitors see the reading, its time, the trend and the rating. Add ?station=koeln (or kaub, maxau, mainz, koblenz, bonn, duesseldorf, emmerich, dresden, magdeburg, passau, wuerzburg) to preselect a station. For the German version, replace /embed/en/ with /embed/de/. Terms: the source line under the gauge stays visible, no warranty. Questions via <a href={route('contact', lang)}>contact</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src={`/embed/${lang}/pegel/`} title="River level today, Pegel Heute" width="100%" height="620" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
