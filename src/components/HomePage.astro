---
/**
 * Accueil : choisir n'importe lequel des pegels des six fleuves (outil en tête), les chiffres clés de la momentaufnahme,
 * la réponse repliée, les douze pegels les plus cherchés en direct, les fleuves et les guides, puis les textes longs
 * en accordéons et la FAQ. Texte : src/content/home.ts.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Clamp from './Clamp.astro';
import Tool from './Tool.astro';
import Body from './Body.astro';
import PegelTabelle from './pegel/PegelTabelle';
import { HOME } from '../content/home';
import { route, hasRoute, type Locale } from '../i18n/routes';
import { GROUPS } from '../i18n/nav';
import { helpers, sourceList, SOURCES } from '../lib/helpers';
import { PAGES } from '../lib/pages';
import { FEATURED, RIVERS, raw, compact } from '../lib/pegel';
import { faqSchema, organizationSchema, websiteSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
interface Props { lang: Locale }
const { lang } = Astro.props;
const x = HOME[lang];
const path = route('home', lang);
const h = helpers(lang);
const faqs = x.faqs(h);
const sources = sourceList(HOME.sources, lang);
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webPageSchema({ name: x.h1, description: x.description, path, lang }), webApplicationSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(faqs, lang)];
const koeln = raw('KÖLN').uuid;
const featured = FEATURED.map((f) => compact(raw(f.api)));
const featuredLinks = Object.fromEntries(FEATURED.map((f) => [raw(f.api).uuid, route(`st-${f.id}`, lang)]));
const rivers = Object.fromEntries(RIVERS.map((r) => [r.api, r[lang]]));
const indep = { de: 'Unabhängige Seite, kein Angebot der WSV oder einer Behörde. Hochwasserwarnungen finden Sie bei den', en: 'Independent site, not a service of the WSV or any authority. Flood warnings are issued by the' }[lang];
const indep2 = { de: 'Hochwasserzentralen der Länder', en: 'German state flood centres' }[lang];
const capt = { de: 'Die zwölf meistgesuchten Pegel (Keyword Planner, November 2026).', en: 'The twelve most searched gauges (Keyword Planner, November 2026).' }[lang];
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={faqs} sources={sources}>
  <header class="mb-4">
    <h1 class="text-[1.7rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">{x.h1}</h1>
    <p class="mt-2 text-base text-navy-700 sm:text-lg" set:html={x.intro(h)} />
    <p data-chrome class="mt-1 text-sm text-navy-600">{indep} <a href={SOURCES(lang).hochwasserzentralen.url} target="_blank" rel="nofollow noopener" class="underline">{indep2}</a>.</p>
  </header>
  <div data-outil data-chrome><Tool kind="pegel" lang={lang} river="alle" initial={koeln} idPrefix="home" /></div>
  <dl data-chrome class="limits my-6 text-sm">
    {x.facts(h).map((f) => <div><dt>{f.k}</dt><dd>{f.v}</dd></div>)}
  </dl>
  <Clamp text={x.resume(h)} lang={lang} id="clamp-home" class="my-8" />
  <section class="mt-8">
    <h2 class="text-2xl font-bold text-navy-900">{x.tableTitle}</h2>
    <div data-chrome><PegelTabelle client:visible lang={lang} stations={featured} waters={RIVERS.map((r) => r.api)} links={featuredLinks} rivers={rivers} caption={capt} /></div>
  </section>
  <section class="mt-10"><Body html={x.why(h)} href={path} lang={lang} /></section>
  <section class="mt-10" data-chrome>
    {GROUPS.map((g) => {
      const list = PAGES.filter((p) => ({ stationen: 'station', fluesse: 'river', wissen: 'guide' } as const)[g.id] === p.kind && hasRoute(p.id, lang));
      return list.length > 0 && (
        <div class="mb-6">
          <h2 class="text-xl font-bold text-navy-900">{g.label[lang]}</h2>
          <ul class="mt-3 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-2 lg:grid-cols-3">
            {list.map((p) => <li><a href={route(p.id, lang)} class="font-medium text-accent-700 underline-offset-2 hover:underline">{p[lang].nav}</a><span class="block text-navy-600">{p[lang].card}</span></li>)}
          </ul>
        </div>
      );
    })}
  </section>
  <section class="mt-10">
    <h2 class="text-2xl font-bold text-navy-900">{x.foldTitle}</h2>
    {x.sections(h).map((s) => <details class="fold"><summary><h3 class="fold-h">{s.title}</h3></summary><div class="pb-4"><Body html={s.html} href={path} lang={lang} /></div></details>)}
  </section>
</PageLayout>
